SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=TORUS Healthcare <noreply@torus.med>
SMTP_USE_TLS=true
SMTP_SSL=false
