# ==============================================================================
# TORUS System Configuration (.env.example)
# ==============================================================================
# Real Email / SMTP Configuration for Doctor Password Reset OTPs
# ==============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=plebctech@gmail.com
SMTP_PASSWORD=your_16_digit_google_app_password_here
SMTP_FROM=TORUS Healthcare <plebctech@gmail.com>
SMTP_USE_TLS=true
SMTP_SSL=false

# ==============================================================================
# Agora RTC Video Call Configuration
# ==============================================================================
AGORA_APP_ID=26da1ebca94b427b80177eff6d44ddfa
AGORA_CHANNEL=torus
AGORA_TOKEN=your_agora_rtc_token_here
OPENSONICS_APP_ID=26da1ebca94b427b80177eff6d44ddfa
OPENSONICS_TOKEN=your_agora_rtc_token_here

# ==============================================================================
# Google Gemini AI Configuration
# ==============================================================================
# Get your free API key from: https://aistudio.google.com/app/apikey
# The key format is: AIzaSy... (starts with AIza)
# Valid model names: gemini-3.8-flash (recommended), gemini-2.5-flash-lite
GEMINI_API_KEY=AIzaSyYOUR_REAL_KEY_FROM_GOOGLE_AI_STUDIO_HERE
GEMINI_MODEL=gemini-3.8-flash
